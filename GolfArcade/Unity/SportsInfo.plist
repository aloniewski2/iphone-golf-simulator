<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CADisableMinimumFrameDurationOnPhone</key>
	<true/>
	<!-- iOS Game Mode: a game gets the CPU and GPU first and background work is held back (iOS 18+); the category is what
	     tells iOS this is a game, the two keys opt in explicitly (GCSupportsGameMode iOS 18, LSSupportsGameMode iOS 26). -->
	<key>GCSupportsGameMode</key>
	<true/>
	<key>LSApplicationCategoryType</key>
	<string>public.app-category.sports-games</string>
	<key>LSSupportsGameMode</key>
	<true/>
	<key>CFBundleDisplayName</key>
	<string>Motion Club Beta</string>
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLName</key>
			<string>com.motionclub.invite</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>motionclub</string>
			</array>
		</dict>
	</array>
	<key>ClubHubInviteBaseURL</key>
	<string></string>
	<key>ClubHubServerURL</key>
	<string></string>
	<key>ClubPrivacyPolicyURL</key>
	<string></string>
	<key>ClubSupportEmail</key>
	<string></string>
	<key>ClubSupportURL</key>
	<string></string>
	<key>NSAppTransportSecurity</key>
	<dict>
		<key>NSAllowsLocalNetworking</key>
		<true/>
	</dict>
	<key>NSBonjourServices</key>
	<array>
		<string>_motionparty._tcp</string>
	</array>
	<key>NSGKFriendListUsageDescription</key>
	<string>Motion Club shows which of your Game Center friends are online, so you can invite them to play.</string>
	<key>NSLocalNetworkUsageDescription</key>
	<string>Motion Club finds and joins friends’ games on the same Wi-Fi.</string>
	<key>UIApplicationSceneManifest</key>
	<dict>
		<key>UIApplicationSupportsMultipleScenes</key>
		<true/>
		<key>UISceneConfigurations</key>
		<dict>
			<key>UIWindowSceneSessionRoleExternalDisplayNonInteractive</key>
			<array>
				<dict>
					<key>UISceneConfigurationName</key>
					<string>Sports External</string>
					<key>UISceneDelegateClassName</key>
					<string>$(PRODUCT_MODULE_NAME).SportsExternalScene</string>
				</dict>
			</array>
		</dict>
	</dict>
</dict>
</plist>
